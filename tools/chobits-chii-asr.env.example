# ASR 门面配置模板。生产：cp 为 /etc/chobits-chii-asr.env 填真实值，chmod 600
# 密钥只存服务器 /etc，不进仓库
CHII_ASR_API_KEY=                    # 门面鉴权 key（垫片持有，openssl rand）
CHII_ASR_BACKEND=funasr              # funasr | qwen3
CHII_ASR_ENGINE_HTTP_URL=http://127.0.0.1:9001
CHII_ASR_ENGINE_WS_URL=ws://127.0.0.1:10095
CHII_ASR_TICKET_SECRET=              # WS 票据 HMAC 密钥，与垫片 ASR_TICKET_SECRET 一致
CHII_ASR_BIND=127.0.0.1              # 生产走 Caddy 反代时绑本机
# CHII_ASR_SSL_CERTFILE=             # 反代模式下不需要（TLS 由 Caddy 终结）
# CHII_ASR_SSL_KEYFILE=
